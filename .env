# 服务器配置
SERVER_NAME=api-docs-manager
SERVER_VERSION=1.0.0

# HTTP服务配置
HTTP_ADDR=0.0.0.0
HTTP_PORT=8999

# Elasticsearch配置
ES_URL=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=your_elasticsearch_password_here

# 索引配置
PROJECT_INDEX=projects
DOCUMENT_INDEX=documents

# JWT认证配置
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters

# 注意：
# - 请将此文件复制为.env.local并填入真实的配置值
# - 真实的敏感信息不要提交到Git仓库
# - 修改ES_PASSWORD和JWT_SECRET为你的实际配置
